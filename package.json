{
  "name": "taiwan-food-adventure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/copy-notices.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "assets": "python3 scripts/create-art.py",
    "test:browser": "node scripts/validate-browser.mjs",
    "profile": "node scripts/profile-static.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "playwright": "1.62.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
